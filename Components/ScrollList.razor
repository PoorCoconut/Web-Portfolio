@* Vertical infinite scroller with faded edges. The list is rendered 3 times and the track slides by one copy, so it wraps seamlessly.
   Size the window with Class (height), style the lines with ItemClass. Pauses on hover. *@
<div class="fade-y relative overflow-hidden @Class">
    <ul class="animate-ticker will-change-transform hover:[animation-play-state:paused]" style="--ticker-dur:@(Duration.ToString(System.Globalization.CultureInfo.InvariantCulture))s;--shift:-33.3333%">
        @for (var pass = 0; pass < 3; pass++)
        {
            foreach (var item in Items)
            {
                <li class="@ItemClass" aria-hidden="@(pass > 0 ? "true" : null)">@item</li>
            }
        }
    </ul>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string ItemClass { get; set; } = "";
    [Parameter] public double Duration { get; set; } = 30;
}
