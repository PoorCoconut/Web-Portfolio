@inject IJSRuntime JS

@* Fixed, click-through backdrop. Back to front: drifting nebula glows, twinkling stars + sparkles, then a big celestial diagram:
   static geometry (a clock face with ticks, axes, circles, crescent hub), orbit rings, a compass star, and two "clock hands":
   an outer moon (slow) and an inner moon (12x faster) that circle independently.
   Performance: everything animates with transform/opacity on its own layer. Scroll + pointer motion is eased (lerp) in portfolio.js
   and written straight to the layers marked data-turn / data-par, so the page itself never has to re-style while you scroll. *@
<div class="cosmos" aria-hidden="true">
    <div class="cosmos-glow" style="left:-18vmax;top:-26vmax;--drift-dur:44s;--drift-x:7vmax;--drift-y:5vmax"></div>
    <div class="cosmos-glow cosmos-glow-b" style="right:-24vmax;bottom:-30vmax;--drift-dur:58s;--drift-x:-6vmax;--drift-y:-4vmax"></div>

    <div class="cosmos-stars cosmos-par" data-par="8" data-par-sy="-18">
        @foreach (var g in _groups)
        {
            <svg class="cosmos-layer tw" style="--tw-dur:@(F(g.Dur))s;--tw-del:@(F(g.Del))s" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" fill="#fff" fill-opacity="@F(g.Op)">
                @foreach (var s in g.Set)
                {
                    <circle cx="@F(s.X)" cy="@F(s.Y)" r="@F(s.R)" />
                }
            </svg>
        }
        <svg class="cosmos-layer tw" style="--tw-dur:8s;--tw-del:1.5s" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" fill="none" stroke="#fff" stroke-width="1">
            @foreach (var s in _sparks)
            {
                <path d="@SparkPath(s)" />
            }
        </svg>
    </div>

    <div class="cosmos-diagram cosmos-par" data-par="-14">

        @* static: clock face (outer ring + ticks), inner ring, axes, circles, crescent hub *@
        <svg class="cosmos-layer" viewBox="0 0 1000 1000">
            <defs>
                <mask id="cres-lg" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="1000">
                    <circle cx="500" cy="500" r="60" fill="#fff" />
                    <circle cx="500" cy="484" r="46" fill="#000" />
                </mask>
            </defs>

            <line class="c-line" x1="500" y1="40" x2="500" y2="960" />
            <line class="c-faint" x1="70" y1="500" x2="930" y2="500" />
            <path class="c-dot" d="M500 22 L504 42 L500 56 L496 42 Z" />
            <path class="c-dot" d="M946 500 L926 496 L914 500 L926 504 Z" />
            <path class="c-dot" d="M54 500 L74 496 L86 500 L74 504 Z" />

            <circle class="c-faint" cx="500" cy="300" r="190" />
            <circle class="c-faint" cx="500" cy="700" r="190" />
            <ellipse class="c-faint" cx="500" cy="500" rx="372" ry="212" />

            <circle class="c-line" cx="500" cy="500" r="290" />
            <path class="c-line" d="@_tickPath" />
            <circle class="c-line" cx="500" cy="500" r="136" />
            <circle class="c-line" cx="500" cy="500" r="66" />

            @foreach (var y in _ticks)
            {
                <circle class="c-dot" cx="500" cy="@y" r="2" />
            }

            <circle class="c-moon" cx="500" cy="500" r="52" mask="url(#cres-lg)" />
            <circle class="c-moon" cx="500" cy="880" r="11" />
        </svg>

        @* orbit rings: each spins on its own, and each turns a different amount as you scroll *@
        <div class="cosmos-turn" data-turn="24">
            <svg class="cosmos-layer spin" style="--spin:90s" viewBox="0 0 1000 1000">
                <circle class="c-dots" cx="500" cy="500" r="345" />
                <circle class="c-dash" cx="500" cy="500" r="235" />
                <circle class="c-line" cx="@Px(345, 20)" cy="@Py(345, 20)" r="8" />
                <circle class="c-line" cx="@Px(345, 150)" cy="@Py(345, 150)" r="12" />
                <circle class="c-line" cx="@Px(345, 265)" cy="@Py(345, 265)" r="7" />
                <circle class="c-dot" cx="@Px(235, 60)" cy="@Py(235, 60)" r="3.5" />
                <circle class="c-dot" cx="@Px(235, 200)" cy="@Py(235, 200)" r="3.5" />
            </svg>
        </div>

        <div class="cosmos-turn" data-turn="-16">
            <svg class="cosmos-layer spin spin-rev" style="--spin:150s" viewBox="0 0 1000 1000">
                <circle class="c-dash" cx="500" cy="500" r="440" />
                <circle class="c-faint" cx="500" cy="500" r="395" />
                <circle class="c-line" cx="@Px(440, 100)" cy="@Py(440, 100)" r="11" />
                <circle class="c-line" cx="@Px(440, 305)" cy="@Py(440, 305)" r="9" />
                <circle class="c-dot" cx="@Px(440, 205)" cy="@Py(440, 205)" r="4.5" />
                <circle class="c-dot" cx="@Px(395, 330)" cy="@Py(395, 330)" r="3" />
            </svg>
        </div>

        <div class="cosmos-turn" data-turn="48">
            <svg class="cosmos-layer spin" style="--spin:55s" viewBox="0 0 1000 1000">
                <circle class="c-dots" cx="500" cy="500" r="190" />
                <circle class="c-dot" cx="@Px(190, 0)" cy="@Py(190, 0)" r="3" />
                <circle class="c-dot" cx="@Px(190, 120)" cy="@Py(190, 120)" r="3" />
                <circle class="c-dot" cx="@Px(190, 240)" cy="@Py(190, 240)" r="3" />
            </svg>
        </div>

        <div class="cosmos-turn" data-turn="-12">
            <svg class="cosmos-layer spin spin-rev" style="--spin:260s" viewBox="0 0 1000 1000">
                <polygon class="c-line" points="@_starPoints" />
                <circle class="c-faint" cx="500" cy="500" r="30" />
            </svg>
        </div>

        @* clock hand 1 (outer ring): slow. One lap per 360s, and 30 degrees over a full page scroll *@
        <div class="cosmos-turn" data-turn="30">
            <svg class="cosmos-layer spin" style="--spin:360s" viewBox="0 0 1000 1000">
                <defs>
                    <mask id="cres-out" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="1000">
                        <circle cx="500" cy="210" r="34" fill="#fff" />
                        <circle cx="500" cy="200" r="24" fill="#000" />
                    </mask>
                </defs>
                <line class="c-line" x1="500" y1="442" x2="500" y2="240" />
                <circle class="c-moon" cx="500" cy="210" r="28" mask="url(#cres-out)" />
            </svg>
        </div>

        @* clock hand 2 (inner ring): 12x faster, like a minute hand against an hour hand *@
        <div class="cosmos-turn" data-turn="360">
            <svg class="cosmos-layer spin" style="--spin:30s" viewBox="0 0 1000 1000">
                <defs>
                    <mask id="cres-in" maskUnits="userSpaceOnUse" x="0" y="0" width="1000" height="1000">
                        <circle cx="500" cy="364" r="22" fill="#fff" />
                        <circle cx="500" cy="358" r="14.5" fill="#000" />
                    </mask>
                </defs>
                <line class="c-line" x1="500" y1="442" x2="500" y2="383" />
                <circle class="c-moon" cx="500" cy="364" r="17" mask="url(#cres-in)" />
            </svg>
        </div>
    </div>

    <i class="shooting" style="left:8%;top:10%;--shoot-del:3s;--shoot-dur:17s"></i>
    <i class="shooting" style="left:58%;top:4%;--shoot-del:11s;--shoot-dur:23s"></i>
</div>

@code {
    private sealed record Star(double X, double Y, double R);
    private sealed record StarGroup(double Dur, double Del, double Op, List<Star> Set);

    private readonly List<StarGroup> _groups = new();
    private readonly List<Star> _sparks = new();
    private readonly int[] _ticks = [130, 190, 270, 350, 430, 570, 650, 730, 810, 900];
    private string _starPoints = "";
    private string _tickPath = "";

    private static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private static string Px(double r, double deg) => F(500 + r * Math.Cos(deg * Math.PI / 180));
    private static string Py(double r, double deg) => F(500 + r * Math.Sin(deg * Math.PI / 180));
    private static string SparkPath(Star s) =>
        $"M{F(s.X - s.R)} {F(s.Y)}H{F(s.X + s.R)}M{F(s.X)} {F(s.Y - s.R)}V{F(s.Y + s.R)}";

    protected override void OnInitialized()
    {
        var rnd = new Random(7); // fixed seed: same sky every render
        List<Star> Make(int n, double r0, double r1) =>
            Enumerable.Range(0, n).Select(_ => new Star(rnd.NextDouble() * 1600, rnd.NextDouble() * 1000, r0 + rnd.NextDouble() * (r1 - r0))).ToList();

        // one layer per depth; each twinkles at its own pace (opacity on its own layer = cheap)
        _groups.Add(new StarGroup(9, 0, .6, Make(110, .5, 1.0)));
        _groups.Add(new StarGroup(7, 2, .85, Make(52, .9, 1.5)));
        _groups.Add(new StarGroup(5, 1, 1, Make(18, 1.3, 2.1)));
        _sparks.AddRange(Make(9, 4, 7));

        // 16-point star: 4 long cardinal spikes, 4 medium diagonals, 8 short ones
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < 32; i++)
        {
            var spike = i / 2;
            var outer = i % 2 == 0;
            var ang = (i * 11.25 - 90) * Math.PI / 180;
            double r = outer ? (spike % 4 == 0 ? 232 : spike % 2 == 0 ? 150 : 100) : 34;
            sb.Append(F(500 + r * Math.Cos(ang))).Append(',').Append(F(500 + r * Math.Sin(ang))).Append(' ');
        }
        _starPoints = sb.ToString().TrimEnd();

        // clock face: 60 ticks just inside the r=290 ring, longer every 5th
        var tp = new System.Text.StringBuilder();
        for (var i = 0; i < 60; i++)
        {
            var a = (i * 6 - 90) * Math.PI / 180;
            var inner = 290 - (i % 5 == 0 ? 16 : 7);
            tp.Append($"M{F(500 + inner * Math.Cos(a))} {F(500 + inner * Math.Sin(a))}L{F(500 + 290 * Math.Cos(a))} {F(500 + 290 * Math.Sin(a))}");
        }
        _tickPath = tp.ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("portfolio.initBackground");
    }
}
